# ==============================================================================
# LOCAL DEVELOPMENT ENVIRONMENT (.env.local)
# ==============================================================================
#
# This file is an EXAMPLE of what your .env.local file should contain
# for LOCAL DEVELOPMENT ONLY.
#
# SETUP INSTRUCTIONS:
# 1. Copy this file to .env.local: cp .env.local.example .env.local
# 2. Fill in the values from your development Firebase project
# 3. NEVER commit .env.local to version control (it's in .gitignore)
# 4. Use the full .env.example file for production reference
#
# This file is listed in .gitignore to prevent accidental commits of secrets
#
# ==============================================================================
# REQUIRED: FIREBASE CLIENT CONFIGURATION
# ==============================================================================
# Get these from Firebase Console for your DEVELOPMENT project
# https://console.firebase.google.com/
#
# Steps:
# 1. Create a new Firebase project (or use existing dev project)
# 2. Go to Project Settings > General tab
# 3. Scroll to "Your apps" section
# 4. Click on Web app (</>) icon
# 5. Copy the config values to variables below

NEXT_PUBLIC_FB_API_KEY=AIzaSyD1234567890abcdefghij_klmnopqrstuv
NEXT_PUBLIC_FB_AUTH_DOMAIN=lecture-helper-dev.firebaseapp.com
NEXT_PUBLIC_FB_PROJECT_ID=lecture-helper-dev
NEXT_PUBLIC_FB_STORAGE_BUCKET=lecture-helper-dev.appspot.com
NEXT_PUBLIC_FB_MESSAGING_SENDER_ID=1234567890
NEXT_PUBLIC_FB_APP_ID=1:1234567890:web:abc123def456ghi789jk

# ==============================================================================
# REQUIRED: FIREBASE ADMIN SDK CONFIGURATION (SERVER-ONLY)
# ==============================================================================
# Get these from Firebase Console > Project Settings > Service Accounts
#
# Steps:
# 1. Go to Firebase Console > Project Settings > Service Accounts tab
# 2. Click "Generate New Private Key" button
# 3. A JSON file will download
# 4. Open the JSON file and copy the values below:
#    - For FIREBASE_ADMIN_CLIENT_EMAIL: copy the "client_email" field
#    - For FIREBASE_ADMIN_PRIVATE_KEY: copy the "private_key" field
#
# IMPORTANT: When pasting the private key:
# - Keep the \n escape sequences as-is (don't replace with actual newlines)
# - Example: -----BEGIN PRIVATE KEY-----\nMIIEv...long key...\n-----END PRIVATE KEY-----\n
# - The \n sequences are necessary for environment variable parsing

FB_ADMIN_CLIENT_EMAIL=firebase-adminsdk-abc123@lecture-helper-dev.iam.gserviceaccount.com
FB_ADMIN_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBgkqhkiG9w0BAQEFAASCBKcwggSjAgEAAoIBAQC7VJTUt...[copy full key]...\n-----END PRIVATE KEY-----\n

# ==============================================================================
# REQUIRED: GOOGLE GEMINI API
# ==============================================================================
# Get this from Google AI Studio
# https://aistudio.google.com/app/apikey
#
# Steps:
# 1. Go to https://aistudio.google.com/app/apikey
# 2. Click "Get API Key"
# 3. If prompted, create a new Google Cloud project or select existing
# 4. Copy the API key value
#
# For free tier development:
# - 60 requests per minute (usually sufficient for local dev)
# - Click "Create API Key in new project" for free tier
#
# You also need to enable the API in Google Cloud Console:
# 1. Go to https://console.cloud.google.com/
# 2. Select your project
# 3. Search for "Generative Language API"
# 4. Click Enable

GEMINI_API_KEY=AIzaSyD1234567890abcdefghij_klmnopqrstuv

# ==============================================================================
# REQUIRED: FAL.AI API
# ==============================================================================
# For audio transcription features
# https://fal.ai/dashboard/keys
#
# Steps:
# 1. Go to https://fal.ai/dashboard/keys
# 2. Click "Create API Key"
# 3. Copy the key value
#
# Free tier includes:
# - Limited requests per month
# - Good for testing/development
# - Check usage at https://fal.ai/dashboard

FAL_KEY=fallback_xxxxxx-your-fal-ai-key-xxxxxx

# ==============================================================================
# OPTIONAL: SENTRY ERROR TRACKING
# ==============================================================================
# For error tracking during local development
# https://sentry.io/ (optional)
#
# During local dev, you can:
# 1. Leave this blank (errors won't be tracked)
# 2. Create a free Sentry account to track errors
#
# If you want to use Sentry:
# 1. Go to https://sentry.io/
# 2. Create an account (free tier available)
# 3. Create a new Next.js project
# 4. Copy the DSN value from Project Settings > Client Keys

# For development, you probably want to leave this empty or use a dev DSN
# NEXT_PUBLIC_SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx@xxxx.ingest.sentry.io/1234567

# During development, set this to "true" to see Sentry debug logs
SENTRY_DEBUG=false

# ==============================================================================
# APPLICATION CONFIGURATION
# ==============================================================================

NODE_ENV=development
# Keep as "development" for local development
# This enables:
# - Hot reload on file changes
# - Detailed error messages
# - Full logging output

NEXT_PUBLIC_BASE_URL=http://localhost:3000
# The URL where your app runs locally
# Leave as http://localhost:3000 for npm run dev

# ==============================================================================
# OPTIONAL: CRON JOB SECURITY
# ==============================================================================
# Only needed if you want to test cron jobs locally
# For production, this MUST be set to a secure random value
#
# For local development, you can use any string:

CRON_SECRET=your_local_development_cron_secret_not_used_in_prod

# ==============================================================================
# LOCAL DEVELOPMENT QUICK START
# ==============================================================================
#
# 1. Copy this file:
#    cp .env.local.example .env.local
#
# 2. Fill in Firebase credentials from your dev project:
#    - NEXT_PUBLIC_FIREBASE_API_KEY
#    - NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN
#    - NEXT_PUBLIC_FIREBASE_PROJECT_ID
#    - NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET
#    - NEXT_PUBLIC_FIREBASE_APP_ID
#    - FIREBASE_ADMIN_CLIENT_EMAIL
#    - FIREBASE_ADMIN_PRIVATE_KEY
#
# 3. Fill in API keys:
#    - GEMINI_API_KEY (from https://aistudio.google.com/app/apikey)
#    - FAL_KEY (from https://fal.ai/dashboard/keys)
#
# 4. Start the dev server:
#    npm run dev
#
# 5. Open http://localhost:3000
#
# ==============================================================================
# COMMON ISSUES & SOLUTIONS
# ==============================================================================
#
# Issue: "Missing required Firebase environment variables"
# Solution: Verify all NEXT_PUBLIC_FIREBASE_* variables are correctly filled
# Debug: Check Firebase Console > Project Settings > Web App Config
#
# Issue: "Firebase Admin initialization failed"
# Solution: Check FIREBASE_ADMIN_PRIVATE_KEY escaping
# - Make sure \n is literal (not actual newlines)
# - Copy from JSON file exactly as shown
# - If it fails, paste it in quotes: "-----BEGIN PRIVATE KEY-----\nMIIEv..."
#
# Issue: "Gemini API key invalid"
# Solution:
# - Verify key at https://aistudio.google.com/app/apikey
# - Make sure Generative Language API is enabled
# - Check you copied the full key (starts with "AIzaSy")
#
# Issue: "FAL.ai authentication failed"
# Solution:
# - Verify key at https://fal.ai/dashboard/keys
# - Make sure key hasn't expired
# - Check you have API quota remaining
#
# Issue: "Port 3000 already in use"
# Solution:
# - npm run dev -- -p 3001  (use different port)
# - Or kill process: lsof -i :3000 && kill -9 <PID>
#
# ==============================================================================
# SECURITY REMINDERS FOR DEVELOPERS
# ==============================================================================
#
# 1. NEVER commit .env.local to Git
#    - It's in .gitignore for a reason
#    - Check: git status (should NOT show .env.local)
#
# 2. Keep credentials secret
#    - Don't share .env.local in Slack, email, or chat
#    - Don't take screenshots of credentials
#    - If you expose a key, immediately:
#      1. Revoke it in the service dashboard
#      2. Generate a new key
#      3. Update .env.local
#
# 3. Use separate credentials for each environment
#    - Development: This .env.local (dev Firebase project)
#    - Staging: Different env vars (staging Firebase project)
#    - Production: Different env vars (production Firebase project)
#
# 4. Rotate credentials regularly
#    - Firebase: Generate new service account key every 90 days
#    - API Keys: Rotate every 30-90 days
#    - After staff leaves: Immediately revoke their credentials
#
# ==============================================================================
# TESTING THAT EVERYTHING WORKS
# ==============================================================================
#
# After filling in .env.local, test each component:
#
# 1. Firebase Auth:
#    - Go to http://localhost:3000/auth/signup
#    - Try signing up with an email
#    - Check Firebase Console > Authentication to see new user
#
# 2. Gemini API:
#    - Go to http://localhost:3000/create
#    - Try generating study materials
#    - Should see AI-generated content
#
# 3. FAL.ai (transcription):
#    - Go to http://localhost:3000/process-lecture
#    - Try uploading an audio/video file
#    - Should see transcription progress
#
# 4. Check browser console for errors:
#    - Press F12 in browser
#    - Go to Console tab
#    - Should be no red errors
#    - Some warnings are normal
#
# 5. Check Next.js terminal output:
#    - Should see "compiled client and server successfully"
#    - No "Error:" messages
#
# ==============================================================================
