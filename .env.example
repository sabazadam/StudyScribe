# ==============================================================================
# CRAMMINGAI - ENVIRONMENT VARIABLES CONFIGURATION
# ==============================================================================
#
# This file documents ALL environment variables required for the CrammingAI
# Next.js application. Copy this file to .env.local for local development or
# .env.production for production deployment.
#
# IMPORTANT SECURITY NOTES:
# - NEVER commit .env.local or .env.production to version control
# - These files are already listed in .gitignore
# - Use your hosting platform's environment variable management for production
# - Rotate secrets immediately if they are exposed
#
# For Vercel deployments: Use Project Settings > Environment Variables
# For AWS: Use Secrets Manager or Parameter Store
# For Docker/K8s: Use secrets management (Docker Secrets, K8s Secrets)
# For self-hosted: Use a secrets management system (Vault, Sealed Secrets, etc.)
#
# ==============================================================================
# SECTION 1: FIREBASE CLIENT CONFIGURATION
# ==============================================================================
# REQUIRED in all environments (development, staging, production)
# These are PUBLIC environment variables exposed to the browser
# Get these values from Firebase Console > Project Settings
#
# Firebase Project: https://console.firebase.google.com/
# Steps:
# 1. Go to Project Settings > General tab
# 2. Copy the config object values to the variables below
# 3. For Web app, click on </> icon to get config

NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyD1234567890abcdefghij_klmnopqrstuv
# Type: string (PUBLIC)
# Description: Firebase API key for client-side authentication and access
# Required: YES
# Source: Firebase Console > Project Settings > Web App Config
# Example: AIzaSyD1234567890abcdefghij_klmnopqrstuv

NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=lecture-helper-abc123.firebaseapp.com
# Type: string (PUBLIC)
# Description: Firebase authentication domain for sign-in/sign-up flows
# Required: YES
# Source: Firebase Console > Project Settings > Web App Config
# Pattern: <project-id>.firebaseapp.com

NEXT_PUBLIC_FIREBASE_PROJECT_ID=lecture-helper-abc123
# Type: string (PUBLIC)
# Description: Firebase project ID, used across authentication and database
# Required: YES
# Source: Firebase Console > Project Settings > Project ID
# Pattern: lowercase alphanumeric with hyphens

NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=lecture-helper-abc123.appspot.com
# Type: string (PUBLIC)
# Description: Firebase Cloud Storage bucket for file uploads
# Required: YES
# Source: Firebase Console > Project Settings > Storage Bucket
# Pattern: <project-id>.appspot.com

NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1234567890
# Type: string (PUBLIC)
# Description: Firebase Cloud Messaging sender ID (optional if not using FCM)
# Required: NO (optional)
# Source: Firebase Console > Project Settings
# Pattern: numeric string

NEXT_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:abc123def456ghi789jk
# Type: string (PUBLIC)
# Description: Firebase app ID for identifying this web application
# Required: YES
# Source: Firebase Console > Project Settings > Web App Config
# Pattern: 1:<numeric>:web:<alphanumeric>

# ==============================================================================
# SECTION 2: FIREBASE ADMIN SDK CONFIGURATION
# ==============================================================================
# REQUIRED for server-side operations (API routes, middlewares)
# PRIVATE: Do NOT expose these to the browser
# Get these from Firebase Console > Project Settings > Service Account
#
# Steps:
# 1. Go to Firebase Console > Project Settings > Service Accounts
# 2. Click "Generate New Private Key"
# 3. Copy the JSON file values below

FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-abc123@lecture-helper-abc123.iam.gserviceaccount.com
# Type: string (PRIVATE - server-only)
# Description: Service account email for Firebase Admin SDK initialization
# Required: YES (for API routes with authentication)
# Source: Firebase Service Account JSON > client_email
# Pattern: firebase-adminsdk-<random>@<project-id>.iam.gserviceaccount.com

FIREBASE_ADMIN_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBgkq...[very long key]...\n-----END PRIVATE KEY-----\n
# Type: string (PRIVATE - server-only)
# Description: Service account private key for admin operations (auth verification, database access)
# Required: YES (for API routes with authentication)
# Source: Firebase Service Account JSON > private_key
# Format: Multi-line PEM format with \n escape sequences
# SECURITY: Keep this SECRET! Never expose in client code or version control
# Note: When setting in environment variables, replace actual newlines with \n

# ==============================================================================
# SECTION 3: GOOGLE AI APIS - GEMINI
# ==============================================================================
# REQUIRED for educational content generation, image generation, and chat
# Get your API key from: https://aistudio.google.com/app/apikey
#
# Steps:
# 1. Go to https://aistudio.google.com/app/apikey
# 2. Click "Get API Key" > "Create API key in new project"
# 3. Copy the API key
# 4. Enable these APIs in Google Cloud Console:
#    - Generative Language API
#    - Cloud Vision API (if using image analysis)

GEMINI_API_KEY=AIzaSyD1234567890abcdefghij_klmnopqrstuv
# Type: string (PRIVATE - server-only)
# Description: Google Generative AI API key for Claude/Gemini model access
# Required: YES
# Usage:
#  - Generate study materials from lectures
#  - Generate quiz questions
#  - Image generation (Imagen 4)
#  - Chat/Q&A with context
# Source: https://aistudio.google.com/app/apikey
# Format: Starts with "AIzaSy"
# SECURITY: Keep this private! Only use in server-side code (API routes)
# Rate limits: Check your billing quota at https://console.cloud.google.com/

# ==============================================================================
# SECTION 4: FAL.AI - AUDIO TRANSCRIPTION & OTHER TASKS
# ==============================================================================
# REQUIRED for audio/video transcription features
# Get your API key from: https://fal.ai/dashboard/keys
#
# Steps:
# 1. Go to https://fal.ai/dashboard/keys
# 2. Create an API key
# 3. Copy the key value

FAL_KEY=fallback_xxxxxx-your-fal-ai-key-xxxxxx
# Type: string (PRIVATE - server-only)
# Description: FAL.ai API key for audio transcription and inference tasks
# Required: YES (if using audio/video transcription)
# Usage:
#  - Transcribe lecture videos/audio files using Whisper API
#  - Other AI inference tasks
# Source: https://fal.ai/dashboard/keys
# SECURITY: Keep this private! Only use in server-side code
# Cost: Per-request billing, monitor usage in FAL.ai dashboard

# ==============================================================================
# SECTION 5: SENTRY ERROR TRACKING & MONITORING
# ==============================================================================
# OPTIONAL but RECOMMENDED for production environments
# Get your DSN from: https://sentry.io/
#
# Steps:
# 1. Create a Sentry account at https://sentry.io/
# 2. Create a new project for Next.js
# 3. Copy the DSN value

NEXT_PUBLIC_SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx@xxxx.ingest.sentry.io/1234567
# Type: string (PUBLIC - safe to expose to browser)
# Description: Sentry Data Source Name for error tracking and performance monitoring
# Required: NO (optional, but recommended for production)
# Usage:
#  - Track JavaScript errors and exceptions
#  - Monitor performance metrics
#  - Track user session replays
#  - Alert on critical errors
# Source: https://sentry.io/ > Project Settings > Client Keys (DSN)
# Format: https://<key>@<host>.ingest.sentry.io/<projectid>
# Empty/Missing: Sentry disabled (app still works without it)

SENTRY_DEBUG=false
# Type: boolean (dev-only)
# Description: Enable debug logging for Sentry in development
# Required: NO
# Default: false
# Usage: Set to "true" to see detailed Sentry logging during development
# Note: Only applies when NODE_ENV === 'development'

# ==============================================================================
# SECTION 6: APPLICATION CONFIGURATION
# ==============================================================================

NODE_ENV=development
# Type: enum: "development" | "staging" | "production"
# Description: Application environment
# Required: YES
# Default: development (automatically set by Next.js in most cases)
# Usage:
#  - Controls error verbosity
#  - Affects Sentry sampling rates
#  - Determines API caching behavior
# Values:
#  - development: Full logging, DST and reload on changes
#  - staging: Production-like with relaxed constraints
#  - production: Minimal logging, optimized performance

NEXT_PUBLIC_BASE_URL=http://localhost:3000
# Type: URL string
# Description: Base URL of the application for absolute links and API calls
# Required: NO (defaults to localhost:3000 in development)
# Usage:
#  - Generate absolute URLs for email links
#  - API endpoints for internal service calls
#  - Social sharing metadata
# Values:
#  - Development: http://localhost:3000
#  - Staging: https://staging.lecture-helper.com
#  - Production: https://lecture-helper.com
# Note: No trailing slash!

# ==============================================================================
# SECTION 7: CRON JOB SECURITY
# ==============================================================================
# REQUIRED for scheduled maintenance tasks (quota resets)
# Used to secure Vercel Cron Jobs or scheduled task endpoints
#
# Steps:
# 1. Generate a secure random string (at least 32 characters)
# 2. Use: `openssl rand -hex 32` or `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
# 3. Set this same value in your cron job scheduler (Vercel, AWS Lambda, etc.)

CRON_SECRET=your_super_secret_cron_key_minimum_32_characters_long_change_this
# Type: string (PRIVATE - server-only)
# Description: Secret key for authenticating scheduled cron jobs
# Required: YES (if using cron jobs for quota resets)
# Usage:
#  - Verify authorization header in /api/cron/reset-quotas
#  - Prevent unauthorized calls to sensitive maintenance endpoints
# Format: Random string, minimum 32 characters (use crypto-grade randomness)
# How to generate:
#  - macOS/Linux: openssl rand -hex 32
#  - Node.js: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#  - Online: https://www.random.org/strings/
# SECURITY: Change this immediately in production! Use a secrets manager.
# Cron Job Setup (Vercel):
#  1. Add to vercel.json:
#     "crons": [{ "path": "/api/cron/reset-quotas", "schedule": "0 0 * * *" }]
#  2. Add CRON_SECRET to environment variables in Vercel dashboard
#  3. Scheduler will call with Authorization: Bearer $CRON_SECRET header

